// Tangerine — data model.
//
// Design notes
// ------------
// * Postgres is the source of truth. Redis holds only derived data
//   (materialized home timelines, presence) which can always be rebuilt.
// * Ids are cuid() strings, sortable enough for demo purposes. In a real
//   system these would be Snowflake ids so that id ordering == time ordering.
// * Denormalized counters (likeCount, commentCount, followerCount) live on the
//   row so feed hydration is a single query instead of N aggregates. They are
//   updated inside transactions alongside the write that changes them.
// * A conversation owns a monotonically increasing `seq` per message. The
//   server, not the client clock, defines message order. `clientMsgId` makes
//   sends idempotent under retries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  PRACTITIONER
  PROVIDER
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  SYSTEM
}

/// Lifecycle of a transactional-outbox event.
///   PENDING   -> written in the same tx as the domain change, not yet published
///   RELAYED   -> published onto the work queue
///   PROCESSED -> the worker finished it
///   FAILED    -> exhausted retries (surfaced for alerting/replay)
enum OutboxStatus {
  PENDING
  RELAYED
  PROCESSED
  FAILED
}

/// Lifecycle of a booking. `HELD` is a soft, expiring reservation that lives in
/// the SAME table as firm bookings on purpose: a single PostgreSQL exclusion
/// constraint then enforces "no two overlapping reservations on one
/// practitioner" atomically across holds and bookings, instead of a racy
/// check-then-insert against two tables.
enum BookingStatus {
  HELD
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id           String   @id @default(cuid())
  handle       String   @unique
  displayName  String
  avatarUrl    String?
  role         Role     @default(MEMBER)
  bio          String?
  headline     String?
  region       String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Denormalized graph counters, kept in sync with Follow writes.
  followerCount  Int @default(0)
  followingCount Int @default(0)

  // Derived flag: true once followerCount crosses the celebrity threshold.
  // Posts by celebrities skip write-time fan-out and are pulled at read time.
  isCelebrity Boolean @default(false)

  posts        Post[]
  likes        Like[]
  comments     Comment[]
  following    Follow[]             @relation("follower")
  followers    Follow[]             @relation("following")
  memberships  ConversationMember[]
  messages     Message[]

  sessionTypes           SessionType[]
  availability           PractitionerAvailability[]
  bookingsAsPractitioner Booking[]            @relation("practitionerBookings")
  bookingsAsMember       Booking[]            @relation("memberBookings")
  bookingOperations      BookingOperation[]
  payments               Payment[]
  products               Product[]            @relation("practitionerProducts")
  cart                   Cart?
  orders                 Order[]              @relation("memberOrders")

  // Health monitoring (Phase 1). A patient is a User; PatientProfile carries the
  // demographics (sex, birth date) needed to resolve age/sex-specific ranges.
  patientProfile PatientProfile?
  clinicalEvents ClinicalEvent[] @relation("patientClinicalEvents")
  observations   Observation[]   @relation("patientObservations")

  @@index([isCelebrity])
}

model Post {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  mediaUrl   String?
  createdAt  DateTime @default(now())

  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  likes    Like[]
  comments Comment[]

  // The primary read pattern is "latest posts by author X, newest first".
  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Follow {
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType @default(DIRECT)
  title       String?
  createdAt   DateTime         @default(now())
  lastMessageAt DateTime?

  // Monotonic per-conversation message sequence. Advanced with an atomic
  // UPDATE ... increment (row lock), so concurrent sends can never collide on
  // seq without any application-level locking.
  lastSeq Int @default(0)

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt(sort: Desc)])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  // Read receipt is a cursor: the highest seq this member has read.
  // Compresses "read up to here" to one integer per member per conversation.
  lastReadSeq Int @default(0)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  type           MessageType  @default(TEXT)

  // Server-assigned, per-conversation monotonic sequence number.
  seq        Int
  createdAt  DateTime @default(now())

  // Client idempotency key: a retried send cannot create a duplicate row.
  clientMsgId String

  @@unique([conversationId, seq])
  @@unique([senderId, clientMsgId])
  @@index([conversationId, createdAt(sort: Desc)])
}

/// Transactional outbox.
///
/// A domain write (e.g. creating a post) and the intent to do follow-up work
/// (fan the post out to followers) are committed in ONE transaction. A separate
/// relay publishes pending rows to a work queue. This removes the classic
/// dual-write problem: we never commit a post and then fail to enqueue its
/// fan-out, and we never enqueue fan-out for a post that rolled back.
///
/// The relay claims rows with `FOR UPDATE SKIP LOCKED`, so many API instances can
/// relay concurrently without stepping on each other.
model OutboxEvent {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  availableAt DateTime     @default(now())
  relayedAt   DateTime?
  processedAt DateTime?

  @@index([status, availableAt])
}

/// Catalog of what a practitioner can be booked for. Price is stored in minor
/// units (cents) as integers — never floats — so ledger arithmetic is exact.
model SessionType {
  id              String   @id @default(cuid())
  practitionerId  String
  practitioner    User     @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  currency        String   @default("USD")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  bookings Booking[]

  @@unique([practitionerId, name])
  @@index([practitionerId, active])
}

/// Recurring weekly availability, expressed in the practitioner's local
/// wall-clock time (weekday + minutes from local midnight) plus an IANA
/// timezone. Slot lookup expands this into concrete UTC instants for the
/// requested date range.
model PractitionerAvailability {
  id             String   @id @default(cuid())
  practitionerId String
  practitioner   User     @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday, in the practitioner's timezone.
  weekday        Int
  /// Minutes from local midnight, inclusive.
  startMinute    Int
  /// Minutes from local midnight, exclusive.
  endMinute      Int
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now())

  @@index([practitionerId, weekday])
}

/// A reservation on a practitioner's calendar. Covers holds and firm bookings.
///
/// The overlap invariant is enforced by a PostgreSQL exclusion constraint
/// created in the migration:
///
///   EXCLUDE USING gist (
///     "practitionerId" WITH =,
///     tstzrange("startTime", "endTime", '[)') WITH &&
///   ) WHERE status IN ('HELD','PENDING','CONFIRMED')
///
/// The database, not application code, is the arbiter of who wins a race for
/// the same slot: the loser gets SQLSTATE 23P01 and we translate it to 409.
model Booking {
  id             String        @id @default(cuid())
  practitionerId String
  practitioner   User          @relation("practitionerBookings", fields: [practitionerId], references: [id], onDelete: Cascade)
  memberId       String
  member         User          @relation("memberBookings", fields: [memberId], references: [id], onDelete: Cascade)
  sessionTypeId  String
  sessionType    SessionType   @relation(fields: [sessionTypeId], references: [id])
  startTime      DateTime      @db.Timestamptz(3)
  endTime        DateTime      @db.Timestamptz(3)
  status         BookingStatus @default(PENDING)

  /// Price captured at booking time so later catalog edits do not rewrite history.
  priceCents Int
  currency   String @default("USD")

  /// Soft-reservation expiry. Only meaningful while status = HELD.
  holdExpiresAt DateTime? @db.Timestamptz(3)

  clientOpId   String?
  confirmedAt  DateTime? @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A create request with the same (member, clientOpId) is the same intent.
  @@unique([memberId, clientOpId])
  @@index([memberId, startTime(sort: Desc)])
  @@index([practitionerId, startTime])
  @@index([status, holdExpiresAt])
  @@index([status, startTime])
}

/// Idempotency ledger for mutating booking operations (reschedule, cancel,
/// hold). The unique (userId, opId) is the retry key: the first request records
/// its result, and a retry with the same op id returns that recorded result
/// instead of repeating the side effect.
model BookingOperation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opId      String
  action    String
  bookingId String?
  response  Json?
  createdAt DateTime @default(now())

  @@unique([userId, opId])
  @@index([createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// Double-entry ledger.
///
/// Invariants (see docs/research/marketplace-payments-research.md §2/§6):
///   * Append-only. No UPDATE/DELETE. Enforced by a BEFORE UPDATE OR DELETE
///     trigger that raises, PLUS `REVOKE UPDATE, DELETE ... FROM PUBLIC`.
///   * Every transaction's postings net to zero. Enforced by a DEFERRABLE
///     INITIALLY DEFERRED constraint trigger that fires at COMMIT, after all
///     legs of the transaction are inserted.
///   * Balances are derived, never stored (aggregate over the append-only
///     postings). A stored balance is a cache that can drift; a sum cannot.
///   * A SHA-256 hash chain over (previousHash, seq, …, postings) makes silent
///     tampering detectable by LedgerService.verifyIntegrity().
/// ─────────────────────────────────────────────────────────────────────────

/// Debit or credit side of a posting.
enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Why a ledger transaction exists.
enum LedgerTransactionKind {
  CHARGE
  REFUND
  PAYOUT
  PLATFORM_FEE
  ESCROW_HOLD
  ESCROW_RELEASE
}

/// One atomic, balanced unit of the ledger. Groups its postings.
model LedgerTransaction {
  id          String                @id @default(cuid())
  /// Global, gap-free, monotonically increasing chain position. Assigned by
  /// the service under an advisory lock (not the DB sequence) so the hash is
  /// computable before insert — an append-only row cannot be UPDATEd later.
  seq         Int                   @unique @default(autoincrement())
  kind        LedgerTransactionKind
  /// Domain object that caused this transaction, e.g. "Order"/"order_123".
  sourceType  String
  sourceId    String
  description String?
  createdAt   DateTime              @default(now())
  /// Previous transaction's hash (null only at genesis).
  previousHash String?
  /// SHA-256 over the canonical encoding of this row + previousHash.
  hash         String

  postings LedgerPosting[]

  /// Idempotency: at most one transaction per (sourceType, sourceId, kind).
  @@unique([sourceType, sourceId, kind])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@index([sourceId])
}

/// A single debit or credit against one account. Append-only.
model LedgerPosting {
  id            String              @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  /// Free-form account key: "user:<id>", "platform", "escrow:<orderId>", …
  accountId     String
  direction     LedgerDirection
  /// Minor units (cents), always integers. Never floats.
  amountCents   Int
  currency      String              @default("USD")
  createdAt     DateTime            @default(now())

  @@index([accountId, currency])
  @@index([transactionId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// Idempotency with recovery points (see docs/research/marketplace-payments-
/// research.md §idempotency). Modelled on Stripe's Rocket Rides design and
/// Brandur's "recovery points" essay.
///
/// Lifecycle: STARTED → COMPLETED, or STARTED → FAILED (retryable).
///   * A retry with the same (userId, key) and an identical requestHash returns
///     the recorded response without repeating the side effect.
///   * The same key with a *different* requestHash is a 409.
///   * `recoveryPoint` records the last durable checkpoint inside the operation
///     so a retry after a crash can resume rather than restart.
///   * `lockToken` is a fencing token: a worker whose lease expired and was
///     taken over cannot overwrite the new attempt's result.
/// ─────────────────────────────────────────────────────────────────────────

enum IdempotencyStatus {
  STARTED
  COMPLETED
  FAILED
}

model IdempotencyKey {
  id             String            @id @default(cuid())
  /// Owning scope: a real user id for user-triggered writes, or a namespace
  /// like "stripe" for provider-triggered work. Not a foreign key: webhook
  /// processing has no authenticated user.
  userId         String
  /// Caller-supplied key, unique within `userId`.
  key            String
  /// SHA-256 of the canonical request; reuse with a different payload is a 409.
  requestHash    String
  status         IdempotencyStatus @default(STARTED)
  /// Last durable checkpoint inside the operation, e.g. "ledger.posted".
  recoveryPoint  String?
  responseStatus Int?
  responseBody   Json?
  /// Fencing token for the current attempt.
  lockToken      String?
  /// When the current attempt began; used to detect an expired lease.
  lockedAt       DateTime?
  /// Recorded result is reusable until this instant (24h, mirroring Stripe).
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, key])
  @@index([status, lockedAt])
  @@index([expiresAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// Webhook ingestion + payments (see docs/research/…§webhooks).
///
/// Webhooks are delivered at-least-once, out of order, and sometimes twice.
/// The inbox row (unique on source + externalEventId) makes ingestion
/// idempotent; the Payment state machine makes application order-independent.
/// ─────────────────────────────────────────────────────────────────────────

/// Lifecycle of an inbound webhook, from receipt to application.
enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

/// Transactional inbox: one row per provider event ever seen.
model WebhookEvent {
  id              String             @id @default(cuid())
  source          String
  externalEventId String
  type            String
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  /// At-least-once delivery: exactly one row per (source, event id).
  @@unique([source, externalEventId])
  @@index([status, receivedAt])
}

/// Payment lifecycle. Minimal in Phase 3; Phase 5 links it to an Order.
enum PaymentStatus {
  CREATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id          String        @id @default(cuid())
  /// Provider id, e.g. a Stripe PaymentIntent id ("pi_…").
  externalId  String        @unique
  ownerId     String?
  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status      PaymentStatus @default(CREATED)
  amountCents Int
  currency    String        @default("USD")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transitions PaymentStateTransition[]

  @@index([status, updatedAt])
}

/// Auditable record of every applied status change (no rows for no-ops).
model PaymentStateTransition {
  id         String        @id @default(cuid())
  paymentId  String
  payment    Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  eventType  String
  createdAt  DateTime      @default(now())

  @@index([paymentId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// Marketplace: products, inventory, cart, orders (see §marketplace).
///
/// Inventory is the contested resource: many checkouts race for few units.
/// A single conditional UPDATE per reservation keeps contention on one row,
/// and `reserved` can never exceed `quantity` (the predicate enforces it).
/// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  RETURNED
  REFUNDED
  CANCELLED
}

enum OrderActorRole {
  MEMBER
  PRACTITIONER
  SYSTEM
}

model Product {
  id                     String     @id @default(cuid())
  practitionerId         String
  practitioner           User       @relation("practitionerProducts", fields: [practitionerId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  priceCents             Int
  currency               String     @default("USD")
  category               String?
  active                 Boolean    @default(true)
  isSponsored            Boolean    @default(false)
  conflictOfInterestNote String?
  createdAt              DateTime   @default(now())

  inventory  InventoryItem?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([practitionerId, active])
  @@index([category, active])
}

model InventoryItem {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  /// reserved can never exceed quantity; the reserve predicate guarantees it.
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id            String    @id @default(cuid())
  cartId        String
  cart          Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  /// Soft hold deadline for the checkout window; expired lines are swept.
  reservedUntil DateTime?
  createdAt     DateTime  @default(now())

  @@unique([cartId, productId])
  @@index([reservedUntil])
}

model Order {
  id              String      @id @default(cuid())
  memberId        String
  member          User        @relation("memberOrders", fields: [memberId], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  totalCents      Int
  currency        String      @default("USD")
  paymentId       String?
  shippingAddress Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items       OrderItem[]
  transitions OrderStateTransition[]

  @@index([memberId, createdAt])
  @@index([status, updatedAt])
}

/// Line snapshot: name and unit price are frozen at checkout time.
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}

model OrderStateTransition {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorRole  OrderActorRole
  actorId    String?
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// Saga orchestration (see §saga). Durable step progress so a long-running
/// checkout can be inspected, retried, or compensated after a crash.
/// ─────────────────────────────────────────────────────────────────────────

enum SagaStatus {
  RUNNING
  COMPLETED
  COMPENSATING
  FAILED
}

model SagaState {
  id               String     @id @default(cuid())
  sagaType         String
  status           SagaStatus @default(RUNNING)
  /// Step currently executing (null when idle/terminal).
  currentStep      String?
  /// Names of steps whose forward action committed, in order.
  completedSteps   Json       @default("[]")
  /// Names of compensations applied, in order.
  compensationsRun Json       @default("[]")
  /// Saga input + accumulated step output (e.g. the payment id to refund).
  context          Json
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([sagaType, status])
  @@index([status, updatedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Health monitoring — Phase 1: clinical events, observations, reference ranges.
//
// Three append-only-ish stores plus a demographic profile:
//   * PatientProfile  — who the patient is (sex, birth date). Needed to resolve
//                       age/sex-specific reference ranges; the observation and
//                       event rows deliberately do NOT denormalize it.
//   * ClinicalEvent   — discrete clinical history: conditions, encounters,
//                       procedures, medication orders. Append-only (Phase 1
//                       migration installs UPDATE/DELETE-rejecting triggers).
//   * Observation     — time-series measurements (vitals, labs, activity, …).
//                       Append-only, same enforcement.
//   * ReferenceRange  — the catalog the derivation layer resolves values
//                       against. Keyed by code + demographics + effective time.
//
// `sourceId` is the originating system's id (e.g. the FHIR resource id) and,
// with patientId, makes ingestion and re-seeding idempotent.
// ─────────────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum ObservationCategory {
  VITAL_SIGNS
  LABORATORY
  ACTIVITY
  SLEEP
  NUTRITION
  SOCIAL_HISTORY
  EXAM
  DEVICE
}

enum ClinicalEventType {
  CONDITION
  ENCOUNTER
  PROCEDURE
  MEDICATION_ORDER
  IMMUNIZATION
  ALLERGY
}

/// Provenance of a clinical event or observation.
enum DataSource {
  MANUAL
  DEVICE
  FHIR_IMPORT
  LAB_FEED
  SEED
}

/// Demographic context for a patient. One per patient User.
model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// Medical record number — the join key used by importers (§ FHIR identifier).
  mrn       String   @unique
  sex       Sex      @default(UNKNOWN)
  birthDate DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([birthDate])
}

/// A discrete clinical event. Append-only: history is the record, and the
/// migration rejects UPDATE/DELETE at the trigger level.
model ClinicalEvent {
  id          String            @id @default(cuid())
  patientId   String
  type        ClinicalEventType
  code        String
  codeSystem  String
  display     String
  status      String?
  /// Clinical onset / encounter start / procedure time / order authoring time.
  onsetAt     DateTime?
  endedAt     DateTime?
  recordedAt  DateTime          @default(now())
  dataSource  DataSource        @default(SEED)
  /// Source-system id (FHIR resource id). Unique per patient -> idempotency.
  sourceId    String
  /// Logical link to a sibling Encounter event (no FK: encounters live here too).
  encounterId String?
  payload     Json?
  createdAt   DateTime          @default(now())

  patient User @relation("patientClinicalEvents", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, sourceId])
  @@index([patientId, type, onsetAt])
  @@index([patientId, code, onsetAt])
  @@index([code, onsetAt])
}

/// A time-series measurement. Append-only.
model Observation {
  id           String              @id @default(cuid())
  patientId    String
  category     ObservationCategory
  code         String
  codeSystem   String              @default("http://loinc.org")
  display      String
  /// Numeric value for quantitative observations (the common case).
  valueNumeric Float?
  /// Non-numeric value (e.g. a coded result) when valueNumeric is null.
  valueString  String?
  valueCode    String?
  valueUnit    String?
  /// When the measurement applies (FHIR effective[x]); the trend axis.
  effectiveAt  DateTime
  /// When it entered the record (FHIR issued). May lag effectiveAt.
  issuedAt     DateTime?
  dataSource   DataSource          @default(SEED)
  sourceId     String
  deviceId     String?
  encounterId  String?
  metadata     Json?
  createdAt    DateTime            @default(now())

  patient User @relation("patientObservations", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, sourceId])
  /// The trend query: one patient, one code, ordered/range-scanned by time.
  @@index([patientId, code, effectiveAt])
  @@index([patientId, category, effectiveAt])
  @@index([code, effectiveAt])
  /// BRIN suits an append-ordered time column on a large, immutable table.
  @@index([effectiveAt], type: Brin)
}

/// Reference range catalog: "for this code, in this unit, for this sex/age
/// band, valid during this window, the normal range is [low, high]".
/// `sex`/age bounds are nullable; null means "applies to any".
model ReferenceRange {
  id            String    @id @default(cuid())
  code          String
  codeSystem    String    @default("http://loinc.org")
  display       String
  valueUnit     String
  sex           Sex?
  ageMinDays    Int?
  ageMaxDays    Int?
  lowValue      Float?
  highValue     Float?
  lowCritical   Float?
  highCritical  Float?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([code, effectiveFrom])
  @@index([code, sex, ageMinDays, ageMaxDays])
}
